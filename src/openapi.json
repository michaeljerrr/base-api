{
  "openapi": "3.0.0",
  "info": {
    "title": "Zaxius",
    "author": "Michael",
    "version": "v1.0.0",
    "description": "Simple and easy to use API."
  },
  "servers": [
    { "url": "/" }
  ],
  "tags": [
    { "name": "AI" },
    { "name": "Anime" },
    { "name": "Downloader" },
    { "name": "Search" },
