    "/news/detik": {
      "get": {
        "summary": "Detik News",
        "description": "Scraping berita terpopuler dari Detik.com",
        "tags": ["News"],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "berita": { "type": "string", "example": "Judul berita terpopuler Detik" },
                      "berita_url": { "type": "string", "format": "uri", "example": "https://news.detik.com/berita/..." },
                      "berita_thumb": { "type": "string", "format": "uri", "nullable": true, "example": "https://akcdn.detik.net.id/...jpg" },
                      "berita_diupload": { "type": "string", "example": "Senin, 25 Nov 2024 10:30 WIB" }
                    }
                  }
                }
              }
            }
          },
          "500": { "description": "Gagal memproses request" }
        }
      }
    },
    "/news/kontan": {
      "get": {
        "summary": "Kontan News",
        "description": "Scraping berita terbaru dari Kontan.co.id",
        "tags": ["News"],
        "responses": {
          "200": {
            "description": "Respon berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "berita": { "type": "string", "example": "Rupiah menguat terhadap dolar AS pada perdagangan pagi ini" },
                      "berita_url": { "type": "string", "format": "uri", "example": "https://www.kontan.co.id/news/rupiah-menguat" },
                      "berita_thumb": { "type": "string", "format": "uri", "nullable": true, "example": "https://img.kontan.co.id/thumb.jpg" },
                      "berita_jenis": { "type": "string", "example": "Makro Ekonomi" },
                      "berita_diupload": { "type": "string", "example": "2 jam lalu" }
                    }
                  }
                }
              }
            }
          },
          "500": { "description": "Gagal memproses request" }
        }
      }
    }
  }
}
